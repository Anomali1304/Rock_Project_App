#!/system/bin/sh
# Rock Project - apply on boot. GENERATED BY THE APP. Do not edit by hand.
BASE=/data/adb/mt6789
P=/sys/module/overclock_mt6789/parameters
LOG=$BASE/boot.log
RES=$BASE/boot_result.json

mkdir -p "$BASE"
if [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 65536 ]; then : > "$LOG"; fi
log() { echo "$(date '+%F %T') $*" >> "$LOG"; }
finish() {   # $1 = ok|fail   $2 = message
  printf '{"time":%s,"status":"%s","message":"%s"}\n' "$(date +%s)" "$1" "$2" > "$RES"
  log "$1: $2"
}
w() { echo "$2" > "$P/$1" 2>>"$LOG" || log "write failed: $1=$2"; }

# 1) wait until Android finished booting (max 180 s)
i=0
until [ "$(getprop sys.boot_completed)" = "1" ]; do
  i=$((i+1))
  if [ "$i" -gt 180 ]; then finish fail "boot_completed timeout"; exit 1; fi
  sleep 1
done

# 2) wait for the kernel module parameters (max 60 s)
i=0
until [ -d "$P" ]; do
  i=$((i+1))
  if [ "$i" -gt 60 ]; then finish fail "overclock_mt6789 not loaded"; exit 2; fi
  sleep 1
done
sleep 3   # let thermal / EEM / vendor init settle

# 3) CPU overclock
@CPU_OC_BLOCK@

# 4) GPU overclock
@GPU_OC_BLOCK@

# 5) Control screen values
@CONTROLS_BLOCK@

if [ "$cpu_ok" -eq 1 ] && [ "$gpu_ok" -eq 1 ]; then
  finish ok "applied"
else
  finish fail "cpu=$cpu_ok gpu=$gpu_ok (see boot.log)"
fi
